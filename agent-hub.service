[Unit]
Description=agent-hub MCP Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/agent-hub
Environment=AGENT_HUB_PORT=9020
Environment=AGENT_HUB_ALLOWED_HOSTS=agenthub.hawaiihath.com,agenthub.hawaiihath.com:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*
Environment=AGENT_HUB_DB=/root/agent-hub/hub.db
Environment=AGENT_HUB_AGENTS=/root/agent-hub/agents.json
Environment=AGENT_HUB_BIND_ADDR=127.0.0.1
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub

[Install]
WantedBy=multi-user.target
